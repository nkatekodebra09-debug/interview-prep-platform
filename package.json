{
  "name": "interview-preparation-platform",
  "private": true,
  "version": "1.0.0",
  "main": "Backend/server.js",
  "type": "module",
  "workspaces": [
    "Frontend"
  ],
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "concurrently -k -n API,WEB \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon Backend/server.js",
    "dev:frontend": "npm --prefix Frontend run dev",
    "seed": "node Backend/seed.js",
    "build": "npm --prefix Frontend run build",
    "lint": "npm --prefix Frontend run lint",
    "format": "prettier --write \"Backend/**/*.js\" \"Frontend/**/*.{js,jsx,css}\"",
    "format:check": "prettier --check \"Backend/**/*.js\" \"Frontend/**/*.{js,jsx,css}\"",
    "preview": "npm --prefix Frontend run preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  }
}
