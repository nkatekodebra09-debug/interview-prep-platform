    {
      "name": "Questions",
      "item": [
        {
          "name": "Create Question (Instructor)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{instructor_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/questions" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"What is 2+2?\",\n  \"type\": \"mcq\",\n  \"options\": [\"2\", \"3\", \"4\"],\n  \"correctAnswer\": \"4\"\n}"
            }
          }
        },
        {
          "name": "Fetch Questions (Student)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/questions" }
          }
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "Submit Answer (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/submissions" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"QUESTION_ID\",\n  \"answer\": \"4\"\n}"
            }
          }
        },
        {
          "name": "View Own Submissions (Student)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{student_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/submissions" }
          }
        },
        {
          "name": "View All Submissions (Instructor)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructor_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/submissions" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/admin/users" }
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/admin/users/:id" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"blocked\": true\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/admin/users/:id" }
          }
        }
      ]
    }
  ]
